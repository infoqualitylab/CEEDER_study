    <edge source="&quot;CLIMATE CHANGE&quot;" target="&quot;YIELDS&quot;">
      <data key="d4">1.0</data>
      <data key="d5">"Climate Change negatively impacts crop yields in West Africa, leading to a median decline of 6%. "</data>
      <data key="d6">a24c97db84957739fb0a983dd2c54c5d</data>
    </edge>
    <edge source="&quot;CLIMATE CHANGE&quot;" target="&quot;CH4 UPTAKE&quot;">
      <data key="d4">1.0</data>
      <data key="d5">"Climate Change is identified as a factor influencing CH4 Uptake."</data>
      <data key="d6">074b514b13d7fb732f7b2d8c00ec86bf</data>
    </edge>
    <edge source="&quot;CLIMATE CHANGE&quot;" target="&quot;TROPICAL TREES&quot;">
      <data key="d4">1.0</data>
      <data key="d5">"Tropical Trees are at risk of extinction due to Climate Change."</data>
      <data key="d6">0e9c51f0e77cb7de623b5321b1975f1f</data>
    </edge>
    <edge source="&quot;CLIMATE CHANGE&quot;" target="&quot;FOREST POLICY&quot;">
      <data key="d4">1.0</data>
      <data key="d5">"Climate Change risks need to be integrated into Forest Policy."</data>
      <data key="d6">0e9c51f0e77cb7de623b5321b1975f1f</data>
    </edge>
    <edge source="&quot;CLIMATE CHANGE&quot;" target="&quot;TROPICAL FORESTS&quot;">
      <data key="d4">1.0</data>
      <data key="d5">"Climate Change is impacting the structure and composition of Tropical Forests."</data>
      <data key="d6">823c08dda0ef4bfee3fc54f016f7144e</data>
    </edge>
    <edge source="&quot;CLIMATE CHANGE&quot;" target="&quot;NUTRIENT ADDITION&quot;">
      <data key="d4">1.0</data>
      <data key="d5">"Nutrient addition and climate change both influence soil extracellular enzyme activities."</data>
      <data key="d6">abda80eba504d6eb74af56b968bdda51</data>
    </edge>
    <edge source="&quot;CLIMATE CHANGE&quot;" target="&quot;EVENT&quot;">
      <data key="d4">2.0</data>
      <data key="d5">Climate Change is recognized as a significant factor, and a potential modulator of plant diversity effects. Specifically, increased soil organic carbon (SOC) stocks in croplands are believed to help resist the effects of Climate Change. The impacts of Climate Change appear to be stronger under wetter conditions and weaker under more arid conditions.</data>
      <data key="d6">489357f7d77d21e208a06c332667b572,522f33553f705fd8f06351c16e864d1b</data>
    </edge>
    <edge source="&quot;CLIMATE CHANGE&quot;" target="&quot;CHELONIANS&quot;">
      <data key="d4">1.0</data>
      <data key="d5">"Chelonians are negatively affected by Climate Change, specifically due to habitat shifts and potential losses."</data>
      <data key="d6">fd80116ab9523ba9722fe86c6f42536c</data>
    </edge>
    <edge source="&quot;CLIMATE CHANGE&quot;" target="&quot;VEGETABLE PRODUCTION SYSTEMS&quot;">
