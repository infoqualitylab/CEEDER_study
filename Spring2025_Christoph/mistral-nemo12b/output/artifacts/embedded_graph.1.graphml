      <data key="d1">"Brazil is a key producer of food globally, making it a significant area of focus for this study."</data>
      <data key="d2">d2224348fd101ca14ab7505473f4be08</data>
    </node>
    <node id="&quot;NATIONAL AVERAGE VALUE&quot;">
      <data key="d0">"CONCEPT"</data>
