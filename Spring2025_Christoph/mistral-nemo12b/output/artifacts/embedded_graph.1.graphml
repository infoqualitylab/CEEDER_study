      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">"3-nitrooxypropanol is a feed additive being evaluated for its effectiveness."</data>
      <data key="d2">71e94182f2792f04a9e245fe7d98bf53</data>
    </node>
    <node id="&quot;FEED ADDITIVE&quot;">
