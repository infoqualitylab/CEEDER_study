      <data key="d1">"Watercourse refers to a natural flowing watercourse."</data>
      <data key="d2">df202b57f5743a087c5ed52f8c0a01f4</data>
    </node>
    <node id="&quot;EARTHWORMS&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">Earthworms are a key factor in the study of greenhouse gas emissions from soil. Specifically, they are the subject of the study, focusing on their impact on greenhouse gas emissions.</data>
      <data key="d2">65de24512bcf905100d1278cec81893e,8ede5f8478c4f3171db5a294d1ce67d6</data>
    </node>
    <node id="&quot;GHG EMISSIONS&quot;">
