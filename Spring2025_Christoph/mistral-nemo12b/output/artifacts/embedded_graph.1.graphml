      <data key="d2">023f593be247e34a6ccb0b0773234348</data>
    </node>
    <node id="&quot;SOIL MICROBIAL BIOMASS CARBON&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Soil Microbial Biomass Carbon refers to the amount of carbon stored in soil microbial biomass."</data>
      <data key="d2">023f593be247e34a6ccb0b0773234348</data>
    </node>
    <node id="&quot;SOIL MICROBIAL NITROGEN&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Soil Microbial Nitrogen refers to the amount of nitrogen stored in soil microbial biomass."</data>
      <data key="d2">023f593be247e34a6ccb0b0773234348</data>
    </node>
