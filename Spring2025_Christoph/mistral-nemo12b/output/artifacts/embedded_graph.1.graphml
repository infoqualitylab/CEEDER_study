      <data key="d2">2ca3c1f687fa4b145556d840bb3eead3</data>
    </node>
    <node id="&quot;STREAMS&quot;">
      <data key="d0">"GEO"</data>
      <data key="d1">"Streams are the location where the effects of climate warming and CO2 increases are being studied."</data>
      <data key="d2">8f9247af8d53667304de84fc718b2a0d</data>
      <data key="d3">"GEO"</data>
    </node>
    <node id="&quot;CLIMATE WARMING&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">Climate Warming refers to the overall warming trend due to increased greenhouse gas concentrations. It is the environmental factor being investigated in streams and serves as the driving force behind the observed changes in soil greenhouse gas fluxes. Furthermore, Climate Warming is the driving force behind the observed phenological changes in plants.</data>
      <data key="d2">0182e92e01b87e5ad1331fbb356992bd,6dbe9bfac37c5a9a248dc0cd8e63d67f,75c03e0422e9783dc737cb24fdf0068c,8f9247af8d53667304de84fc718b2a0d,e8c0a7fc07896bb6977749092ff3a515</data>
    </node>
    <node id="&quot;CO2&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">CO2, or carbon dioxide, is a significant factor influencing leaf litter decomposition rates. It is also a greenhouse gas that contributes to ocean acidification and serves as a key variable in various studies.</data>
      <data key="d2">1f78616e6b65c9d016f9135e80758760,8f9247af8d53667304de84fc718b2a0d,e3c4800a89fd40114b42745c3913c502</data>
    </node>
    <node id="&quot;CARBON CYCLE&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"The Carbon Cycle is the global process being affected by elevated CO2 levels."</data>
      <data key="d2">8f9247af8d53667304de84fc718b2a0d</data>
    </node>
    <node id="&quot;BIOCHEMISTRY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">"Biochemistry is the field of study examining the effects of climate change on streams."</data>
      <data key="d2">8f9247af8d53667304de84fc718b2a0d</data>
    </node>
    <node id="&quot;TEMPERATURE INCREASE&quot;">
      <data key="d0">"EVENT"</data>
      <data key="d1">"Temperature Increase refers to the increase in temperature that is being studied in the context of the research."</data>
      <data key="d2">ffd80fc13c11173739e3903adb558b3e</data>
    </node>
    <node id="&quot;CONSERVATION AGRICULTURE&quot;">
      <data key="d0">"ORGANIZATION"</data>
      <data key="d1">Conservation Agriculture is a set of farming practices designed to improve soil health and productivity. These practices include techniques such as zero tillage and residue retention, and are currently being investigated for their impact on various agricultural outcomes.</data>
      <data key="d2">3bb60408eabfc030e9273819e1bd4b43,7273edb81c1631979821309a07c3cae7</data>
    </node>
    <node id="&quot;CONSERVATION AGRICULTURE PRACTICES&quot;">
