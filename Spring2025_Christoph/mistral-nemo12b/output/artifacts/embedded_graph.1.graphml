      <data key="d0" />
      <data key="d1" />
      <data key="d2">1333043c14eff637016e6ecb92fa2dd0</data>
    </node>
    <node id="&quot;SOIL MICROBIAL DIVERSITY&quot;">
      <data key="d0">"CONCEPT"</data>
      <data key="d1">Soil Microbial Diversity refers to the variety of microorganisms inhabiting soil. The study of soil microbial diversity focuses on understanding the effects of multiple global change factors on this variety of microorganisms.</data>
      <data key="d2">76b172515cd810e614844730c72e0644,b007ddcba413c3eaebd3f88aa1539d51</data>
    </node>
    <node id="&quot;GLOBAL CHANGE FACTORS&quot;">
      <data key="d0">"EVENT"</data>
